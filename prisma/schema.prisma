generator client {
  provider        = "prisma-client"
  output          = "../app/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  // NOTE: url lives in prisma.config.ts, NOT here.
}

model User {
  id                   String   @id @default(uuid())
  walletAddress        String?  @unique
  email                String?  @unique
  passwordHash         String?
  isVerified           Boolean  @default(false)
  verificationToken    String?  @unique
  verificationTokenExpires DateTime?
  verifiedAt           DateTime?
  createdAt            DateTime @default(now())
  totalEarnedUnits       BigInt   @default(0)
  pendingBalanceUnits    BigInt   @default(0)
  submissionCount      Int      @default(0)
  goldCorrect          Int      @default(0)
  goldAttempted        Int      @default(0)
  isBanned             Boolean  @default(false)
  bannedAt             DateTime?
  bannedReason         String?
  banCount             Int      @default(0)
  bannedUntil          DateTime?
  lastBanAt            DateTime?
  country              String?
  gender               String?
  ageRange             String?
  onboardingCompleted  Boolean  @default(false)
  lastSubmissionAt     DateTime?
  // XP loop (#201, ADR-0010). XP is never money. lastGoalDay is a Manila day key.
  xp                   Int      @default(0)
  streakDays           Int      @default(0)
  bestStreak           Int      @default(0)
  restDays             Int      @default(0)
  lastGoalDay          String?
  // Tiers (#202, ADR-0011): 0 Starter … 3 Expert. Never lowered; a missed floor
  // holds the tier instead, and passes in a row since then reopen it.
  tier                 Int      @default(0)
  tierOnHold           Boolean  @default(false)
  holdChecksPassed     Int      @default(0)
  // Weekly board (#203, ADR-0012). Names are opt-in, stored lowercase, unique.
  // An admin hide retires the name, clears it and sets displayNameHiddenAt,
  // which asks the labeler to choose another.
  displayName          String?  @unique
  showOnBoard          Boolean  @default(false)
  displayNameHiddenAt  DateTime?
  // Invites (#203, ADR-0012). inviteCode is made on first read; invitedById is
  // set only when the account is created through an invite link.
  inviteCode           String?  @unique
  invitedById          String?
  invitedBy            User?    @relation("Invites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees             User[]   @relation("Invites")

  submissions   Submission[]
  disputes      Dispute[]
  balanceLedger UserBalanceLedger[]
  payoutJobs    PayoutJob[]
  identifierHistory UserIdentifierHistory[]
  flaggedWithdrawals FlaggedWithdrawal[]
  sponsoredTrustlines SponsoredTrustline[]
  legacyEarningsBackfill LegacyEarningsBackfill?
  xpEvents      XpEvent[]
  dailyProgress DailyProgress[]
  stamps        UserStamp[]
  eventRedemptions EventRedemption[]
  weeklyResults WeeklyResult[]
  inviteRewardAsInvitee InviteReward? @relation("InviteRewardInvitee")
  inviteRewardsAsInviter InviteReward[] @relation("InviteRewardInviter")

  @@map("users")
}

// ST-4e follow-up (#330) — one row per platform-sponsored USDC trustline. Each
// outstanding row (revokedAt = null) represents ~0.5–1.5 XLM of platform reserves
// locked on the recipient's behalf. Counting outstanding rows per user enforces a
// hard cap so one labeler can't loop fresh keypairs and drain the pooled account's
// reserves (an economic DoS on mainnet). `revokedAt` is set when reserve reclaim
// (#29, `lib/sponsorship-reclaim.ts`) records the reserves released.
// `address` is a case-sensitive `G…` StrKey and is never normalized.
model SponsoredTrustline {
  id        String    @id @default(uuid())
  userId    String
  address   String
  kind      String    // "trustline" | "account+trustline"
  txHash    String
  // #27: "pending" is written before broadcast, "confirmed" once Horizon accepts,
  // "failed" only when the envelope can never apply. Pending counts as outstanding.
  status      String    @default("confirmed")
  confirmedAt DateTime?
  // The envelope's maxTime: after it, an unreported pending envelope cannot land.
  expiresAt   DateTime?
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  // #29: the revocation envelope recorded before it is broadcast, and its maxTime.
  // Kept after it lands, as the hash that released the reserve.
  reclaimTxHash    String?
  reclaimExpiresAt DateTime?
  // #29: how the reserve was released, set with `revokedAt`:
  // "sponsor_revoke" (our revocation landed) | "owner" (the chain already shows it gone).
  releasedBy       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([address])
  @@unique([address], name: "sponsored_trustlines_outstanding_address_key", map: "sponsored_trustlines_outstanding_address_key", where: raw("\"revokedAt\" IS NULL AND \"status\" <> 'failed'"))
  @@map("sponsored_trustlines")
}

// #29 — one row per executed sponsored-reserve reclaim run. `report` is the
// per-sponsorship disposition (skips, failures, hashes, reserve units, stroops)
// keyed by sponsorship id; it holds no keys, user ids, contact data or wallet
// addresses. A dry run writes nothing; a null `finishedAt` marks a run that died
// mid-way.
model SponsorshipReclaimRun {
  id               String    @id @default(uuid())
  network          String
  sponsor          String
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  reclaimedStroops BigInt    @default(0)
  report           Json?

  @@index([startedAt])
  @@map("sponsorship_reclaim_runs")
}

enum BannedIdentifierType {
  EMAIL
  WALLET
  USER_ID
}

model BannedIdentity {
  id             String             @id @default(uuid())
  identifierType BannedIdentifierType
  identifierValue String
  bannedAt       DateTime           @default(now())
  bannedUntil    DateTime?
  reason         String?

  @@unique([identifierType, identifierValue])
  @@index([identifierType, identifierValue])
  @@map("banned_identities")
}

enum IdentifierType {
  EMAIL
  WALLET
}

model UserIdentifierHistory {
  id           String        @id @default(uuid())
  userId       String
  identifierType IdentifierType
  identifierValue String
  linkedAt     DateTime      @default(now())
  unlinkedAt   DateTime?
  isActive     Boolean       @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([identifierType, identifierValue])
  @@index([userId, isActive])
  @@map("user_identifier_history")
}

model AdminUser {
  id                          String    @id @default(uuid())
  email                       String    @unique
  passwordHash                String
  role                        AdminRole
  companyName                 String?
  createdAt                   DateTime  @default(now())
  isVerified                  Boolean   @default(false)
  verificationToken           String?   @unique
  verificationTokenExpires    DateTime?
  verifiedAt                  DateTime?

  campaigns Campaign[]
  auditLogs AdminAuditLog[]
  eventCodes EventCode[]
  uploadJobs UploadJob[]

  @@map("admin_users")
}

enum AdminRole {
  SUPER_ADMIN
  CUSTOMER
}

model Campaign {
  id                    String   @id @default(uuid())
  adminUserId           String
  name                  String
  defaultResponseTarget Int
  rewardUnits             BigInt
  csvFileName           String?
  pausedAt              DateTime?
  // #202: the lowest tier served this campaign's tasks. 0 Everyone, 1 Skilled and up, 2 Trusted and up.
  minTier               Int      @default(0)
  createdAt             DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id])
  tasks     Task[]
  uploadJobs UploadJob[]
  balance    CampaignBalance?
  balanceLedger BalanceLedger[]

  @@index([adminUserId])
  @@map("campaigns")
}

model Task {
  id             String   @id @default(uuid())
  prompt         String
  responseA      String
  responseB      String
  modelA         String?
  modelB         String?
  category       String?
  isGold         Boolean  @default(false)
  goldAnswer     String?
  createdAt      DateTime @default(now())
  campaignId     String?
  responseTarget Int?
  rewardUnits      BigInt?
  majorityAnswer String?
  agreementScore Float?
  resolvedAt     DateTime?
  disabled       Boolean   @default(false)
  // 1–9, from the 9 Oct pool pricing (#201). Sets the answer's XP band; null pays the lowest.
  difficulty     Int?

  submissions Submission[]
  campaign    Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, prompt])
  @@index([isGold])
  @@index([campaignId])
  @@index([isGold, createdAt])
  @@map("tasks")
}

model Submission {
  id              String    @id @default(uuid())
  // Nullable as of ST-5d: identity is the FK `userId`, not the wallet. Email-only
  // answerers have no linked wallet, so a submission may have no walletAddress.
  // Retained (not dropped) for forensic/analytics use when a wallet IS linked.
  walletAddress   String?
  userId          String
  taskId          String
  choice          String
  reason          String
  isGoldCheck     Boolean   @default(false)
  goldPassed      Boolean?
  payoutAmountUnits BigInt
  payoutTxHash    String?
  payoutStatus    String    @default("pending")
  retryCount      Int       @default(0)
  payoutError     String?
  lastRetriedAt   DateTime?
  createdAt       DateTime  @default(now())
  // #202: the labeler's tier when they answered, for exports; null before #202.
  labelerTier     Int?
  // #202: a gold check answered during retest. Kept out of the tier floors.
  retest          Boolean   @default(false)

  user User @relation(fields: [userId], references: [id])
  task Task @relation(fields: [taskId], references: [id])
  payoutJob PayoutJob?
  payoutAttempts PayoutAttempt[]

  @@unique([userId, taskId])
  @@index([userId])
  @@index([payoutStatus])
  @@index([payoutStatus, createdAt])
  @@index([payoutStatus, retryCount])
  @@index([lastRetriedAt])
  @@index([taskId])
  @@map("submissions")
}

model Dispute {
  id            String   @id @default(uuid())
  walletAddress String   // no FK to User — intentional for forensic/compliance retention if user is deleted
  userId        String?
  reason        String
  status        String   @default("open") // "open" | "resolved"
  createdAt     DateTime @default(now())
  resolvedAt    DateTime?

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([walletAddress])
  @@index([status, createdAt])
  @@map("disputes")
}

model WalletNonce {
  id                String   @id @default(uuid())
  walletAddress     String
  nonce             String   @unique
  // Which flow issued the challenge: "link-payout-address" (/api/me/wallet) or
  // "prove-stellar-address" (wallet sign-in, #25). Every query is scoped by it,
  // so neither flow can delete or satisfy the other's challenges.
  action            String   @default("link-payout-address")
  // Bound at issue for sign-in challenges; the link flow leaves it null.
  networkPassphrase String?
  issuedAt          DateTime @default(now())
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  @@index([walletAddress])
  @@unique([walletAddress, action])
  @@index([expiresAt])
  @@map("wallet_nonces")
}

model AdminAuditLog {
  id           String   @id @default(uuid())
  adminUserId  String
  action       String   // "eventCode.create", "displayName.hide", "campaign.create", "campaign.update", "campaign.delete", "customer.create", "customer.delete", "tasks.upload", "tasks.upload.queued", "tasks.upload.completed", "tasks.upload.failed", "tasks.upload.retry", "export.download"
  targetType   String   // "campaign", "adminUser", "submission"
  targetId     String?  // nullable for bulk actions like "tasks.upload"
  metadata     Json?    // shape depends on action; capture diff for updates, count for bulk
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId, createdAt])
  @@index([action, createdAt])
  @@map("admin_audit_log")
}

enum UploadJobStatus {
  queued
  processing
  done
  failed
  cancelled
}

/// One signed payout envelope for a submission, recorded before it is submitted
/// (#38). The submission id is the payout's idempotency key; each envelope
/// signed under it is an attempt. An `open` attempt may still land on-chain, so
/// no payer builds another envelope, and the co-signer signs none, until it is
/// settled by its hash: `confirmed` (it applied) or `void` (it provably never
/// can). The partial unique index makes "one live envelope per submission" a
/// database rule rather than a code convention.
model PayoutAttempt {
  id           String    @id @default(uuid())
  submissionId String
  envelopeHash String    @unique
  /// The envelope's maxTime: no ledger closing after it can include it.
  expiresAt    DateTime
  /// open | confirmed | void
  status       String    @default("open")
  /// Why a settled attempt settled, e.g. `rejected: tx_bad_seq` or `expired unincluded`.
  outcome      String?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId], name: "payout_attempts_one_open_per_submission", map: "payout_attempts_one_open_per_submission", where: raw("\"status\" = 'open'"))
  @@index([submissionId])
  @@index([status, expiresAt])
  @@map("payout_attempts")
}

enum PayoutJobStatus {
  queued
  processing
  done
  failed
}

enum PayoutJobType {
  SUBMISSION_PAYOUT
  WITHDRAWAL
}

model PayoutJob {
  id                 String          @id @default(uuid())
  type               PayoutJobType   @default(SUBMISSION_PAYOUT)
  // Per-submission payouts reference a submission; lump-sum withdrawals do not.
  submissionId       String?         @unique
  // Lump-sum withdrawals reference the user + snapshot the amount and destination
  // at request time. Null for per-submission payouts (derived from the submission).
  userId             String?
  amountUnits          BigInt?
  destinationAddress String?
  txHash             String?
  broadcastAt        DateTime?
  status             PayoutJobStatus @default(queued)
  workerHeartbeatAt  DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  lastError          String?
  retryCount         Int             @default(0)
  // #38: not claimable before this instant. Set when a job stands down on a
  // payout envelope whose fate is not yet known, so it waits without spinning
  // and without spending a retry.
  notBefore          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([status, workerHeartbeatAt])
  @@index([broadcastAt])
  @@index([status, completedAt])
  @@index([userId])
  @@unique([userId], name: "payout_jobs_user_inflight_withdrawal_key", map: "payout_jobs_user_inflight_withdrawal_key", where: raw("\"type\" = 'WITHDRAWAL' AND \"status\" IN ('queued', 'processing')"))
  @@map("payout_jobs")
}

model UploadJob {
  id                String           @id @default(uuid())
  campaignId        String
  adminUserId       String
  fileName          String
  fileSize          Int
  status            UploadJobStatus  @default(queued)
  totalRows         Int
  processedRows     Int              @default(0)
  upsertedRows      Int              @default(0)
  skippedRows       Int              @default(0)
  errorRows         Int              @default(0)
  chunksCommitted   Int              @default(0)
  chunksTotal       Int              @default(0)
  errorSamples      Json?
  lastError         String?
  rawText           String
  workerHeartbeatAt DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adminUser AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([status, createdAt])
  @@index([campaignId, createdAt])
  @@index([status, workerHeartbeatAt])
  @@map("upload_jobs")
}

enum LedgerType {
  DEPOSIT
  DEBIT_REWARD
  DEBIT_FEE
  REFUND
}

model CampaignBalance {
  id         String   @id @default(uuid())
  campaignId String   @unique
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  balanceUnits BigInt   @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("campaign_balances")
}

model BalanceLedger {
  id           String     @id @default(uuid())
  campaignId   String
  campaign     Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type         LedgerType
  amountUnits    BigInt
  submissionId String?    // no FK — intentional: ledger entries survive submission lifecycle changes
  note         String?
  createdAt    DateTime   @default(now())

  @@index([campaignId, createdAt])
  @@map("balance_ledger")
}

enum UserLedgerType {
  CREDIT_REWARD
  WITHDRAWAL
  REVERSAL
}

// Off-chain labeler balance ledger — mirrors BalanceLedger. Approved answers used to
// credit pendingBalanceUnits (CREDIT_REWARD); withdrawals debit it (WITHDRAWAL);
// failed/reversed withdrawals re-credit (REVERSAL). #39 retired accrual: no new
// CREDIT_REWARD is written, and the rows are kept for audit (ADR-0007).
model UserBalanceLedger {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         UserLedgerType
  amountUnits    BigInt
  submissionId String?        // no FK — intentional: ledger entries survive submission lifecycle changes
  note         String?
  createdAt    DateTime       @default(now())

  @@index([userId, createdAt])
  @@map("user_balance_ledger")
}

// #39 (ADR-0007): what the legacy earnings backfill added to each user —
// `amountUnits` to totalEarnedUnits and `accruedCount` to submissionCount, from
// their `accrued` answers, which accrual credited to pendingBalanceUnits only. One row per user; its presence is what makes the
// backfill run once.
model LegacyEarningsBackfill {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountUnits  BigInt
  accruedCount Int
  appliedAt    DateTime @default(now())

  @@map("legacy_earnings_backfill")
}

// Why a withdrawal was blocked by the P4a/P4b anti-fraud gates. Severity orders the
// admin review queue (P4c): a banned identity is more urgent than a quality gate.
enum FlaggedWithdrawalReason {
  BANNED_IDENTITY  // an email/wallet/userId on the account is on the ban list — CRITICAL
  SHARED_WALLET    // the destination wallet is cashing out for too many accounts — HIGH
  INELIGIBLE       // failed a quality/age/min-submission eligibility gate — LOW
}

enum FlaggedWithdrawalStatus {
  PENDING   // awaiting admin review
  APPROVED  // admin cleared the flag; the labeler may retry the withdrawal
  REJECTED  // admin dismissed the attempt (optionally with a ban)
}

// P4c — every withdrawal blocked by an anti-fraud gate is recorded here so admins
// have a review queue with the trigger reason. The withdraw endpoint still rejects
// the attempt synchronously; this row is the audit/review artifact. Resolutions are
// also written to AdminAuditLog. One PENDING row per (userId, reason) — repeated
// blocked attempts refresh the existing row rather than spamming the queue.
model FlaggedWithdrawal {
  id               String                  @id @default(uuid())
  userId           String
  walletAddress    String?
  reason           FlaggedWithdrawalReason
  detail           Json?                   // trigger context: accountCount, identifierType, gate reason, required/actual
  balanceUnits       BigInt                  @default(0) // pending balance snapshot at flag time
  status           FlaggedWithdrawalStatus @default(PENDING)
  resolvedByAdminId String?
  resolvedAt       DateTime?
  resolutionNote   String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
  @@unique([userId, reason], name: "flagged_withdrawals_userId_reason_pending_uniq", map: "flagged_withdrawals_userId_reason_pending_uniq", where: { status: "PENDING" })
  @@map("flagged_withdrawals")
}

// QA fixture lifecycle (#86 / B9). One row per `qa:fixtures seed`, closed out by
// the matching reset.
//
// This is the evidence trail D1 QA cites. `fixtures` maps each stable slug to the
// row id it resolved to on this run, which is what makes a payout reference
// readable months later: the slug says what the fixture meant, the id says which
// `submission:<id>` or `payout_job:<id>` carried it. Ids are fresh every run
// because a payout reference is never reused, so the slug alone cannot identify
// anything without this map.
//
// `preservedCount` is the number of rows a reset refused to remove because they
// carried a real Horizon hash. It is deliberately recorded rather than inferred:
// a non-zero value means real funds moved through a fixture reference, which is
// the one outcome QA must notice rather than discover later.
model QaFixtureRun {
  id             String    @id @default(uuid())
  runId          String    @unique
  gitSha         String
  network        String
  fixtures       Json
  seededCount    Int       @default(0)
  deletedCount   Int?
  preservedCount Int?
  note           String?
  seededAt       DateTime  @default(now())
  resetAt        DateTime?

  @@index([seededAt])
  @@map("qa_fixture_runs")
}

enum XpKind {
  ANSWER
  QUALITY_CHECK
  DAILY_GOAL
  STREAK_MILESTONE
  CROWD_MATCH
  EVENT_CODE
  QUEST
  INVITE
}

// XP ledger (#201, ADR-0010). Append-only, like BalanceLedger: never updated or
// deleted. dedupeKey makes every award idempotent: answer:<submissionId>,
// check:<submissionId>, goal:<userId>:<dayKey>, streak:<userId>:<dayKey>.
model XpEvent {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         XpKind
  amount       Int
  submissionId String?  // no FK — same reasoning as UserBalanceLedger
  dedupeKey    String   @unique
  dayKey       String   // Manila day
  weekKey      String   // Monday of that Manila week
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([weekKey, userId])
  @@map("xp_events")
}

// One row per labeler per Manila day they did anything the loop counts.
// `protected`: /api/task had nothing open for them that day, so it can't break
// their streak. `restUsed`: a rest day covered it.
model DailyProgress {
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayKey    String
  counted   Int     @default(0)
  goalMet   Boolean @default(false)
  protected Boolean @default(false)
  restUsed  Boolean @default(false)

  @@id([userId, dayKey])
  @@map("daily_progress")
}

// #202: a stamp is earned once. Definitions live in lib/gamification/stamps.ts.
model UserStamp {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stampId   String
  awardedAt DateTime @default(now())

  @@id([userId, stampId])
  @@map("user_stamps")
}

// Event codes (#203, ADR-0012). Each code gives its own stamp, `event:<id>`, and
// 25 XP, once per account, on the Manila days startsDay..endsDay inclusive.
// `code` is stored uppercase and matched case-insensitively.
model EventCode {
  id               String   @id @default(uuid())
  code             String   @unique
  stampTitle       String
  stampIcon        String
  startsDay        String
  endsDay          String
  createdByAdminId String
  createdBy        AdminUser @relation(fields: [createdByAdminId], references: [id])
  createdAt        DateTime @default(now())

  redemptions EventRedemption[]

  @@map("event_codes")
}

// One per account per code: the key is what makes a second redemption fail.
model EventRedemption {
  eventCodeId String
  eventCode   EventCode @relation(fields: [eventCodeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([eventCodeId, userId])
  @@index([userId])
  @@map("event_redemptions")
}

// A display name an admin hid. It can't be chosen again, by anyone.
model RetiredDisplayName {
  name      String   @id
  retiredAt DateTime @default(now())

  @@map("retired_display_names")
}

// A closed week of the board: its row is written once, by whichever read or
// cron gets there first, in the same transaction as its results and stamps.
model BoardWeek {
  weekKey  String   @id
  closedAt DateTime @default(now())

  @@map("board_weeks")
}

// Where each placed labeler finished a closed week, for "Best: #6".
model WeeklyResult {
  weekKey String
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank    Int
  xp      Int

  @@id([weekKey, userId])
  @@index([userId])
  @@map("weekly_results")
}

// An invite that paid off (#203): written once, when the invitee first reaches
// Skilled. The key is the invitee, so it pays once. inviterRewarded is false
// past the inviter's cap of 10; the invitee is rewarded either way.
model InviteReward {
  inviteeId       String   @id
  invitee         User     @relation("InviteRewardInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  inviterId       String
  inviter         User     @relation("InviteRewardInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviterRewarded Boolean
  createdAt       DateTime @default(now())

  @@index([inviterId])
  @@map("invite_rewards")
}
