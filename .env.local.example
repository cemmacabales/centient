DATABASE_URL=postgresql://postgres:postgres@localhost:5432/centient_dev

# Chain — pick one. Defaults to mainnet (42220).
# Mainnet:
NEXT_PUBLIC_CHAIN_ID=42220
CELO_RPC_URL=https://forno.celo.org
# Testnet (Celo Sepolia):
# NEXT_PUBLIC_CHAIN_ID=11142220
# CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
# NEXT_PUBLIC_EXPLORER_URL is a Stellar concern now (explorer links point to
# stellar.expert) — leave it unset to default to stellar.expert for the active
# STELLAR_NETWORK, or set it explicitly in the Stellar block below.
#
# NOTE: the CELO_* / NEXT_PUBLIC_CHAIN_ID vars above are retained only while the
# Wave 2–5 consumers (lib/payout.ts, lib/celo-balance.ts, lib/admin-data.ts,
# lib/metamask.ts) are still on viem. They are removed once those migrate.

# ── Stellar chain config (ST-1a #291 — Wave 1 chain foundation) ──
# Network to target: "testnet" (default) or "public". Drives the Horizon URL,
# the transaction network passphrase, and the stellar.expert explorer base.
STELLAR_NETWORK=testnet
# Optional Horizon override (defaults: testnet https://horizon-testnet.stellar.org,
# public https://horizon.stellar.org).
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Platform hot-wallet secret (S… seed) the payout rail signs USDC payments with.
# Must be a funded account on the active network (XLM for fees/reserves + a USDC
# trustline + USDC float) for real payouts. Generate a throwaway for local dev
# with: node -e "console.log(require('@stellar/stellar-sdk').Keypair.random().secret())"
# On testnet, `node scripts/stellar-testnet-setup.mjs` friendbot-funds it and adds
# the USDC trustline; then faucet USDC at https://faucet.circle.com (Stellar Testnet).
STELLAR_PLATFORM_SECRET=S_your_funded_platform_account_secret
# REQUIRED — the USDC issuer (G… account) payouts settle in. usdcAsset() throws
# if unset, so every payout/withdrawal route 500s without it. Circle testnet USDC:
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Optional asset code (defaults to USDC).
# STELLAR_USDC_CODE=USDC
# NEXT_PUBLIC_EXPLORER_URL (declared above) also overrides the Stellar explorer
# base; leave it unset to default to stellar.expert for the active network.
# Payout multisig co-signers (issue #5) — PUBLIC keys (G…) of the two independent
# signers on the 2-of-3 payout account. Set + verify with
# `pnpm stellar:multisig:setup` / `:verify` — see docs/stellar-multisig-runbook.md.
# STELLAR_OPS_SIGNER_PUBLIC=G_your_ops_cosigner_public_key
# STELLAR_POLICY_SIGNER_PUBLIC=G_your_policy_cosigner_public_key
# Payout service (issue #7). REQUIRED for any payout: the public key of the
# 2-of-3 payout account (must match STELLAR_PLATFORM_SECRET when both are set).
# parsePayoutSignerConfig() refuses to build a payout without it.
# STELLAR_PLATFORM_ACCOUNT=G_your_platform_hot_wallet_public_key
# First signature. REQUIRED: the platform signs every payout with the ops
# seed before handing the envelope to the co-signer.
# STELLAR_OPS_SIGNER_SECRET=S_your_ops_signer_seed
# Second signature. In production it comes from the independent policy
# co-signer service (issue #8), never from this environment. Until #8 ships,
# a local co-signer can hold the policy seed for TESTNET proofs only — it is
# refused on the public network, and both variables below must be set for it
# to exist at all. Without a configured co-signer the rail fails closed.
# STELLAR_ALLOW_LOCAL_COSIGNER=false
# STELLAR_POLICY_SIGNER_SECRET=S_testnet_only_policy_seed

# --- App side: reaching the deployed co-signer (issue #8, ADR-0001) ---
# Setting COSIGNER_URL switches the payout service to the deployed co-signer and
# retires the local signer above. The app then must NOT carry
# STELLAR_POLICY_SIGNER_SECRET at all — holding both is refused at startup,
# because a process that can produce both signatures is not a 2-of-3.
# COSIGNER_URL=https://your-cosigner.up.railway.app/cosign
# Shared HMAC secret, 32+ chars, identical on both deployments. It authenticates
# the request; it is NOT what makes the co-signature safe (the co-signer
# re-derives the payout from the ledger regardless of who is asking).
# COSIGNER_SHARED_SECRET=generate_with_openssl_rand_hex_32
# Declared deployment topology: same-workspace | separate-account.
# same-workspace is the MVP simulation and is REFUSED on the public network.
# COSIGNER_ISOLATION_LEVEL=same-workspace

# --- Co-signer side: set these ONLY in the co-signer's own Railway project ---
# Never in the application's environment. The co-signer refuses to start if any
# is missing — there are deliberately no fallbacks, because falling back to
# DATABASE_URL would hand it the app's read-write connection and falling back to
# DAILY_PAYOUT_CAP_UNITS would make its cap the same cap.
# STELLAR_POLICY_SIGNER_SECRET=S_the_policy_seed   # lives here and nowhere else
# COSIGNER_DATABASE_URL=postgresql://centient_cosigner:...  # read-only role
# COSIGNER_DAILY_CAP_UNITS=2000000000              # 200 USDC; its own cap, UTC day
# COSIGNER_PORT=8080

# Cold USDC reserve — a separate native Stellar 2-of-3 account. The application
# stores public identities and policy only; cold seeds must never be placed in
# the deployed app environment. See docs/stellar-cold-reserve-runbook.md.
# STELLAR_COLD_RESERVE_ACCOUNT=G_your_cold_reserve_master_public_key
# STELLAR_COLD_OPS_SIGNER_PUBLIC=G_your_cold_ops_cosigner_public_key
# STELLAR_COLD_POLICY_SIGNER_PUBLIC=G_your_cold_policy_cosigner_public_key
# STELLAR_PLATFORM_ACCOUNT (declared above) is also the hot destination the
# offline custodians refill.
# Refill when hot USDC is <= 25; restore exactly 100; retain at least 50 in cold.
# Values are exact 7-decimal Stellar units (1 USDC = 10000000 units).
# STELLAR_HOT_FLOAT_TRIGGER_UNITS=250000000
# STELLAR_HOT_FLOAT_TARGET_UNITS=1000000000
# STELLAR_COLD_MIN_RETAIN_UNITS=500000000
# Setup session only — never deploy this variable:
# STELLAR_COLD_RESERVE_SECRET=S_cold_master_seed_for_initial_setup_only
# Disposable testnet setup only. Never enable on public network:
# STELLAR_ALLOW_TESTNET_KEY_GENERATION=false
# Offline signing session only — exactly one custodian seed per invocation:
# STELLAR_COLD_SIGNER_SECRET=S_exactly_one_custodian_seed
# STELLAR_RESERVE_REFILL_AMOUNT_UNITS=750000000
# STELLAR_RESERVE_REFILL_XDR=AAAA_unsigned_or_partially_signed_envelope

# Legacy EVM/Celo server hot wallet — still consumed by the un-migrated payout
# path. Stellar wallet-health checks use STELLAR_PLATFORM_SECRET below instead.
# Must be a valid 32-byte hex private key (0x + 64 hex chars). For local dev you
# can use a throwaway/unfunded key just to boot the app — generate one with:
#   echo "0x$(openssl rand -hex 32)"
# Real payouts need this funded; an invalid value is tolerated (wallet health
# reports "not configured") but on-chain payouts will fail.
PAYOUT_PRIVATE_KEY=0x_your_funded_hot_wallet_private_key

# Reward asset — Stellar USDC (7 decimals; 1 USDC = 10^7 units). The
# REWARD_TOKEN_ADDRESS below is a legacy EVM/Celo artifact still consumed by the
# un-migrated viem payout path; it is removed in the closing viem-removal step
# (post ST-4c), not here. ST-2b (#294) owns the symbol/decimals value-unit.
REWARD_TOKEN_ADDRESS=0x765DE816845861e75A25fCA122bb6898B8B1282a
NEXT_PUBLIC_REWARD_TOKEN_SYMBOL=USDC
NEXT_PUBLIC_REWARD_TOKEN_DECIMALS=7
NEXT_PUBLIC_REWARD_AMOUNT=0.05

# Admin dashboard (/admin) — required for the operator tool at /admin.
# ADMIN_JWT_SECRET must be ≥ 32 chars. Generate with: openssl rand -hex 32
ADMIN_JWT_SECRET=change_me_to_a_random_64_char_hex_string_from_openssl_rand
# Optional override for the seeded default admin password.
# Re-seeding after the row exists leaves the password untouched, so rotating
# after first deploy requires either updating admin_users.password_hash directly
# or removing the row and re-seeding with ADMIN_SEED_PASSWORD set.
# ADMIN_SEED_PASSWORD=GoCent!123
RESEND_API_KEY=get_api_key_from_resend_com
NEXT_PUBLIC_APP_URL=your_local_host_url
RESEND_EMAIL_FROM=email_placeholder

# Gold task serving ratio — fraction of tasks served as platform gold checks.
# Must be between 0 and 1. Defaults to 0.1 (10% gold).
# GOLD_TASK_RATIO=0.1

# Reason repetition detection — flags identical/near-identical submission reasons.
# REASON_REPEAT_WINDOW=10   (default 10) — number of recent reasons to compare against
# REASON_REPEAT_MAX=3       (default 3)  — exact duplicate threshold; submitting the same
#                                         reason >= MAX times within the window is blocked

# Internal Centient customer account — used for dogfooding.
# Set this to seed the customer account in non-production environments.
# INTERNAL_CUSTOMER_PASSWORD=GoCent!123

# Sentry — error tracking for client and server.
SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
NEXT_PUBLIC_SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz

# Stellar wallet balance thresholds — Discord alerting, /api/health/wallet,
# and the authenticated /api/cron/wallet-health check use these. Values are
# human-readable USDC/XLM amounts (each has seven decimal places on Stellar).
BALANCE_WARN_USDC=50
BALANCE_PAGE_USDC=10
BALANCE_WARN_XLM=5
BALANCE_PAGE_XLM=2
# Health monitor thresholds. Payout volume is in seven-decimal Stellar units.
# HEALTH_PAYOUT_WINDOW_MINUTES=60
# HEALTH_PAYOUT_COUNT_THRESHOLD=100
# HEALTH_PAYOUT_VOLUME_UNITS_THRESHOLD=1000000000
# HEALTH_FAILURE_WINDOW_MINUTES=15
# HEALTH_FAILURE_COUNT_THRESHOLD=3
# HEALTH_CAP_PERCENT_THRESHOLD=80
# HEALTH_REFILL_OVERDUE_MINUTES=30
# HEALTH_ALERT_COOLDOWN_MS=900000
# HEALTH_ALERT_DELIVERY_TIMEOUT_MS=10000
# Bound on every Redis call the health path makes (alert leases, refill timer).
# REDIS_OPERATION_TIMEOUT_MS=2000
# Deadline for the Horizon reads behind a wallet-health check. The Stellar SDK
# waits forever by default, so this bound is what degrades a stalled Horizon to
# an explicit monitoring error instead of hanging the cron.
# STELLAR_HORIZON_TIMEOUT_MS=10000

# Discord webhook for wallet balance alerts (optional — no-op if unset).
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# PostHog — product analytics.
NEXT_PUBLIC_POSTHOG_KEY=phc_...
ANALYTICS_HMAC_SECRET=change_me_for_webhook_verification

# Hot-wallet per-day spend cap (application-layer), in seven-decimal USDC
# units. Defaults to 200 USDC (200 * 10^7 = 2000000000). Set to 0 to disable.
# DAILY_PAYOUT_CAP_UNITS=2000000000

# Redis URL for persistent alert cooldown state (Railway provides REDIS_URL automatically).
# Only needed if DISCORD_WEBHOOK_URL is also set.
# REDIS_URL=redis://localhost:6379

# Discord webhook URL for cap threshold alerts (80% consumed).
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Cron endpoint authentication — shared secret between the platform scheduler
# (cron-job.org, Railway cron, Vercel CRON, etc.) and the /api/cron/* endpoints.
# Generate with: openssl rand -hex 32
# CRON_SECRET=change_me_to_a_random_64_char_hex_string_from_openssl_rand

# Platform fee deducted from campaign balance per submission (in seven-decimal
# USDC units). Required when campaign balance is enabled. 0.15 USDC = 1500000
PLATFORM_FEE_UNITS=1500000

# Minimum accumulated USDC balance a labeler must reach before withdrawing (in
# seven-decimal Stellar units), so each payout stays fee-economical. Required
# and fail-fast: the withdrawal endpoint errors if this is unset/invalid.
# 1 USDC = 10000000 units.
MIN_WITHDRAWAL_UNITS=10000000

# Withdrawal eligibility gates (P4a, anti-fraud) — quality history required to
# cash out, so mass-created wallet-less accounts can't instantly withdraw. Each
# gate is opt-in: unset or 0 disables it. Recommended production values shown.
# WITHDRAWAL_MIN_SUBMISSIONS=50
# WITHDRAWAL_MIN_GOLD_RATE=0.7
# WITHDRAWAL_MIN_ACCOUNT_AGE_HOURS=24

# ── Local MiniPay simulation (dev only; hard-off when NODE_ENV=production) ──
# Set to 1 to simulate running inside MiniPay end-to-end (login + payout) with
# no MetaMask, no MiniPay account, and no Celo connection. Run `pnpm payout`
# alongside `pnpm dev` so the queued payout job is processed.
# NEXT_PUBLIC_SIMULATE_MINIPAY=1
# Optional: override the simulated labeler's local test key (throwaway, no funds).
# NEXT_PUBLIC_SIMULATED_WALLET_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
#
# When this flag is on, the app opens to a Login screen with a "Login with
# MiniPay" button (uses the simulated key) and an extra dev-only
# "Simulate MiniPay login" button.
